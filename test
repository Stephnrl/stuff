ENT=octo-enterprise
HOST=github.com   # or your GHES / ghe.com hostname

gh api graphql --hostname "$HOST" --paginate \
  -f slug="$ENT" -f query='
query($slug: String!, $endCursor: String) {
  enterprise(slug: $slug) {
    organizations(first: 100, after: $endCursor) {
      pageInfo { hasNextPage endCursor }
      nodes { login name createdAt url }
    }
  }
}' \
  --jq '.data.enterprise.organizations.nodes[] | [.login, .name, .createdAt, .url] | @csv' \
  > "${ENT}-orgs.csv"
